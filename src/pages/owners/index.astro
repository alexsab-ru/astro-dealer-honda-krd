---
import PageLayout from '@/layouts/PageLayout.astro';
import AdvantagesList from '@/components/Advantages/List.astro';
import settings from '@/data/settings.json';
const { site_name, brand, legal_entity, legal_inn, legal_city, phone_common, email_common } = settings;
const ownersPages = [
    // {
    //     iconName: 'mdi:oil', 
    //     iconClass: 'text-accent-500', 
    //     title: 'Оригинальные масла и жидкости', 
    //     text: '<a href="/owners/oils/" class="btn">Подробнее</a>'
    // },
    {
        iconName: 'mdi:car-battery', 
        iconClass: 'text-accent-500', 
        title: 'Преимущества оригинальных запасных частей', 
        text: '<a href="/owners/original_spare_parts/" class="btn">Подробнее</a>'
    },
    {
        iconName: 'mdi:calendar-clock-outline', 
        iconClass: 'text-accent-500', 
        title: 'Срок поставки запчастей', 
        text: '<a href="/owners/sparepartstime/" class="btn">Подробнее</a>'
    },
    {
        iconName: 'mdi:file-document-outline', 
        iconClass: 'text-accent-500', 
        title: 'Руководства и регламенты ТО', 
        text: '<a href="/owners/docs/" class="btn">Подробнее</a>'
    },
    {
        iconName: 'mdi:car-cog', 
        iconClass: 'text-accent-500', 
        title: 'Запись на сервис', 
        text: '<a href="/service-request/" class="btn">Подробнее</a>'
    },
];
---

<PageLayout
    h1="Владельцам"
    title="Владельцам"
    description={`Владельцам ${brand} ${legal_city}`}
    breadcrumb={[{name:"Владельцам",href:""}]}
>

    <AdvantagesList items={ownersPages} classes="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 text-center mt-14" />

</PageLayout>