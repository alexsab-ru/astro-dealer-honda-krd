<PageLayout
    h1="Руководства и регламенты ТО Honda"
    title="Руководства и регламенты ТО Honda"
    description={`Руководства и регламенты ТО Honda`}
    breadcrumb={[{name:"Руководства и регламенты ТО Honda",href:""}]}
>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-5 gap-y-10 pt-10">

        {items.map(item => (
            <div class="bg-gray-100 p-5">
                <div class="relative font-bold text-xl border-b-2 xs:h-[55px] h-[80px] mb-5 pr-20">
                    {item.name}
                    <img src={item.image} alt={item.name} class="absolute right-0 -top-10 xs:max-w-[100px]! max-w-[145px]!">
                </div>
                <div class="h-[170px] relative overflow-y-auto custom-scrollbar">
                    {
                        item.links.map(link => (
                            <a class="text-sm! md:text-base! mb-1.5! sm:mb-2! lg:mb-3! block" href={link.url} target="_blank" rel="noopener noreferrer">
                                <div class="hover:underline">{link.title}</div>
                                <div class="text-gray-400">{link.size}</div>
                            </a>
                        ))
                    }
                </div>
            </div>
        ))}

    </div>
</PageLayout>
