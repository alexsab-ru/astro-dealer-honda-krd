---
import settings from '@/data/settings.json';
import modelsData from '@/data/models.json'
import Layout from '@/layouts/Layout.astro';
import PageH1 from '@/components/PageH1/Index.astro';
import SectionWithBg from '@/components/SectionWithBg/SectionWithBg.astro';
import AdvantagesList from '@/components/Advantages/List.astro';
import AdvantagesItem from '@/components/Advantages/Item.astro';
import Input from '@/components/Input.astro';
import Checkbox from '@/components/Checkbox/Checkbox.astro';
import Button from '@/components/Button/Button.astro';
const advantages = [ 
    {iconName: 'mdi:check-bold', iconClass: 'text-accent-500', title: 'Белая схема:', text: 'Мы гарантируем юридическую чистоту, безопасность и прозрачность сделки. Без скрытых комиссий и навязанных услуг.'},
    {iconName: 'mdi:check-bold', iconClass: 'text-accent-500', title: 'Полный пакет:', text: 'Поиск автомобиля, общение с поставщиками, подготовку документов, прохождение экспортных процедур и доставку мы возьмем на себя.'},
    {iconName: 'mdi:check-bold', iconClass: 'text-accent-500', title: '*Защита от неприятностей:', text: 'Вы получаете 3 года или 100 000 км защиты от поломок на приобретенный новый автомобиль. Для автомобилей с пробегом –1 год или 30 000 км.'},
    {iconName: 'mdi:check-bold', iconClass: 'text-accent-500', title: 'Послепродажная поддержка:', text: 'Вам будет доступно квалифицированное обслуживание и склад запасных частей. Ждем вас в официальных сервисах компании Honda.'}
];
const steps = [ 
    {iconName: 'mdi:numeric-1-circle', iconClass: 'text-accent-400!', title: 'ВЫБОР', text: 'Выбрать желаемую модель а/м и версию на сайте или у дилера'},
    {iconName: 'mdi:numeric-2-circle', iconClass: 'text-accent-400!', title: 'ПОДБОРКА', text: 'Выбрать автомобиль из предложенных вариантов'},
    {iconName: 'mdi:numeric-3-circle', iconClass: 'text-accent-400!', title: 'ДОГОВОР И ДЕПОЗИТ', text: 'Заключить с дилером агентский Договор. Депозит для брони а/м'},
    {iconName: 'mdi:numeric-4-circle', iconClass: 'text-accent-400!', title: 'ПРИОБРЕТЕНИЕ', text: 'Подписать Договор на покупку и оплатить автомобиль'},
    {iconName: 'mdi:numeric-5-circle', iconClass: 'text-accent-400!', title: 'ПРИЯТНОЕ ОЖИДАНИЕ', text: 'Автомобиль в пути. Примерно 1 месяц'},
    {iconName: 'mdi:numeric-6-circle', iconClass: 'text-accent-400!', title: 'ТАМОЖЕННОЕ ОФОРМЛЕНИЕ', text: 'Подписание документов. Оплата таможенных сборов и услуг агента'},
    {iconName: 'mdi:numeric-7-circle', iconClass: 'text-accent-400!', title: 'КЛЮЧИ', text: 'Теперь вы можете забрать свой автомобиль у дилера'},
];
import {AGREE_LABEL} from '@/const';
const { models } = modelsData;
const modelList = models.map(model => ({id: model.id, name: model.name, thumb: model.thumb}));
---

<Layout title={`Honda под заказ: от мечты до ключей!`} description={`Принимаем Ваши заявки по программе «Honda под заказ». У нас большой выбор моделей, выгода до 20% и 3 года защиты от поломок!`}>
	
	<section class="bg-accent-500 text-white pb-0! xl:py-0!">
		<div class="container px-0">
			<div class="grid lg:grid-cols-2 gap-5 sm:gap-10 items-center">
				<div class="px-5 flex flex-col gap-5">
					<PageH1 h1=`Honda под заказ: <br/>от мечты до ключей!` classes="h1 fz-3 leading-none" />
					<p class="xl:text-xl">Принимаем Ваши заявки по программе «Honda под заказ». <br/>У нас большой выбор моделей, выгода до 20% и 3 года защиты от поломок!<sup>*</sup></p>
					<a href="#offer" class="scroll-link btn white self-start">Отправить заявку</a>
				</div>
				<img src="https://cdn.alexsab.ru/pages/honda/pod-zakaz/top-cars.webp" width="745" height="349" alt="" class="mt-auto" loading="lazy">
			</div>
		</div>
	</section>

	<section>
		<div class="container">
			<h2>Доверяя заказ автомобиля официальной дилерской сети Honda в России, <br/>Вы страхуете себя от неприятных сюрпризов:</h2>
			<AdvantagesList items={advantages} classes="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-10 text-center mt-14" />
		</div>
	</section>

	<SectionWithBg image={{desktop: 'https://cdn.alexsab.ru/pages/honda/pod-zakaz/bg-2.webp'}} fixed classes='py-32!'>
		<div class="container">
			<div class="max-w-[465px] text-left">
				<h2 class="p-0! before:hidden! text-left! w-full! mb-5">Спокойствие и приятные хлопоты</h2>
				<p>Скорость, комфорт и безопасность – эти понятия присущи не только Вашему автомобилю Honda: сделка по заказу Вашего автомобиля с OOO «Мотор Плейс» (HondaOfficial) - это гарантия оперативности и Вашего спокойствия.</p>
			</div>
		</div>
	</SectionWithBg>

	<section class="">
		<div class="container">
			<h2 class="">Порядок заказа автомобиля</h2>
			<div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 lg:gap-10 text-center mt-14">
				{steps.map(item => <AdvantagesItem item={item} classes="bg-[#000000]/90 py-6 lg:py-10 px-5 flex flex-col items-center *:text-white"/> )}
				<div class="text-center py-6 lg:py-10 px-5">
					<img src="https://cdn.alexsab.ru/pages/honda/pod-zakaz/keys.webp" class="h-[100px] lg:h-[150px] mx-auto" alt="Keys">
				</div>
			</div>
		</div>
	</section>

	<section class="bg-gray-100" id="offer">
		<div class="container">
			<h2 class="">Отправьте заявку!</h2>
			<p class="text-center mt-6 mb-10">Выберите модель, заполните контактную информацию, отправьте заявку и мы свяжемся с Вами в самое ближайшее время!</p>

			<form 
				class="grid gap-14" 
				x-data={`
					{
						models: ${JSON.stringify(modelList)}, 
						currentModel: ${JSON.stringify(modelList[0])},
						modelName: 'HONDA ' + ${JSON.stringify(modelList[0])}.name
					}
				`}
				x-cloak
			>
				<input type="hidden" name="form" value="Заказ авто" />
				<input type="email" tabindex="-1" name="email" class="sr-only" placeholder="mail@example.com" />
				<input type="hidden" name="model" x-model="modelName">

				<div class="grid lg:grid-cols-2 gap-10 lg:gap-5">
					<div>
						<h3>Шаг 1</h3>
						<p>Выберите модель</p>

						<div class="flex flex-col sm:flex-row gap-1.5 mt-5">
							<div class="flex sm:flex-col justify-center flex-wrap gap-1.5">
								{models.map(model => (
									<a 
										href="javascript:void(0)" 
										class="btn flex-auto"
										:class={`{'btn-o gray': currentModel.id != '${model.id}'}`}
										@click={`currentModel = models.find(m => m.id === '${model.id}'); modelName = 'HONDA ' + currentModel.name`}
									>{model.name}								
									</a>
								))}
							</div>
							<div class="border border-gray-500 flex flex-col justify-between px-4 py-3 grow">
								<h4 class="text-accent-500 h4 text-2xl" x-text="currentModel.name"></h4>
								<img :src="currentModel.thumb" class="max-w-[360px] w-full h-auto mx-auto" :alt="'HONDA ' + currentModel.name" />
							</div>
						</div>

					</div>
					<div>
						<h3>Шаг 2</h3>
						<p>Контактная информация</p>
						<div class="grid gap-5 mt-5">
							<Input name="name" classes="border-gray-100" placeholder="Ваше имя" />
							<Input
								type="tel"
								name="phone"
								classes="border-gray-100"
								placeholder="+7 (999) 999-99-99*"
								required
								errorText="Телефон является обязательным полем"
							/>
							<Checkbox
								name="agree"
								label={AGREE_LABEL}
								color="black"
								required
								errorText="Чтобы продолжить, установите флажок"
							/>

							<input
								type="checkbox"
								name="subscribe"
								class="absolute w-0 h-0 opacity-0 invisible"
							/>

							<Button view="form-button" classes="w-full" title="Отправить" />
						</div>
					</div>
				</div>

			</form>
			

		</div>
	</section>

</Layout>
